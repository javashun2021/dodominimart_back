<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.mall.mapper.MallBannerMapper">

    <resultMap id="BannerResult" type="com.ruoyi.mall.domain.MallBanner">
        <id     property="bannerId"   column="banner_id"/>
        <result property="imageUrl"   column="image_url"/>
        <result property="linkType"   column="link_type"/>
        <result property="linkValue"  column="link_value"/>
        <result property="sort"       column="sort"/>
        <result property="status"     column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="cols">banner_id, image_url, link_type, link_value, sort, status, create_time, update_time</sql>

    <select id="selectActiveBanners" resultMap="BannerResult">
        SELECT <include refid="cols"/>
        FROM mall_banner
        WHERE status = '0'
        ORDER BY sort ASC, banner_id ASC
    </select>

    <select id="selectAllBanners" resultMap="BannerResult">
        SELECT <include refid="cols"/>
        FROM mall_banner
        ORDER BY sort ASC, banner_id ASC
    </select>

    <select id="selectBannerById" resultMap="BannerResult">
        SELECT <include refid="cols"/> FROM mall_banner WHERE banner_id = #{bannerId}
    </select>

    <insert id="insertBanner" useGeneratedKeys="true" keyProperty="bannerId">
        INSERT INTO mall_banner (image_url, link_type, link_value, sort, status, create_time)
        VALUES (#{imageUrl}, #{linkType}, #{linkValue}, #{sort}, #{status}, #{createTime})
    </insert>

    <update id="updateBanner">
        UPDATE mall_banner
        <set>
            <if test="imageUrl  != null">image_url  = #{imageUrl},</if>
            <if test="linkType  != null">link_type  = #{linkType},</if>
            <if test="sort      != null">sort       = #{sort},</if>
            <if test="status    != null">status     = #{status},</if>
            link_value  = #{linkValue},
            update_time = NOW()
        </set>
        WHERE banner_id = #{bannerId}
    </update>

    <delete id="deleteBannerById">
        DELETE FROM mall_banner WHERE banner_id = #{bannerId}
    </delete>

</mapper>
