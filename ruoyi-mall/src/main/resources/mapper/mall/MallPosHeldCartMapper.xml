<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallPosHeldCartMapper">

    <resultMap type="com.ruoyi.mall.domain.MallPosHeldCart" id="HeldCartResult">
        <id     property="id"          column="id"           />
        <result property="cashierId"   column="cashier_id"   />
        <result property="memberId"    column="member_id"    />
        <result property="label"       column="label"        />
        <result property="cartJson"    column="cart_json"    />
        <result property="itemCount"   column="item_count"   />
        <result property="totalAmount" column="total_amount" />
        <result property="remark"      column="remark"       />
        <result property="status"      column="status"       />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="heldCartVo">
        select id, cashier_id, member_id, label, cart_json, item_count, total_amount,
               remark, status, create_time, update_time
        from mall_pos_held_cart
    </sql>

    <insert id="insertHeldCart" parameterType="com.ruoyi.mall.domain.MallPosHeldCart" useGeneratedKeys="true" keyProperty="id">
        insert into mall_pos_held_cart(cashier_id, member_id, label, cart_json, item_count, total_amount, remark, status, create_time)
        values(#{cashierId}, #{memberId}, #{label}, #{cartJson}, #{itemCount}, #{totalAmount}, #{remark}, '0', #{createTime})
    </insert>

    <select id="selectHeldCartById" parameterType="Long" resultMap="HeldCartResult">
        <include refid="heldCartVo"/> where id = #{id}
    </select>

    <select id="selectOpenHeldCarts" resultMap="HeldCartResult">
        <include refid="heldCartVo"/> where status = '0' order by create_time asc
    </select>

    <select id="countAll" resultType="int">
        select count(1) from mall_pos_held_cart
    </select>

    <update id="updateStatus" parameterType="com.ruoyi.mall.domain.MallPosHeldCart">
        update mall_pos_held_cart
        set status = #{status}, update_time = #{updateTime}
        where id = #{id}
    </update>

</mapper>
