<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.ImspayMerchantMapper">

    <resultMap type="com.ruoyi.mall.domain.ImspayMerchant" id="ImspayMerchantResult">
        <id     property="id"                  column="id"                     />
        <result property="code"                column="code"                   />
        <result property="name"                column="name"                   />
        <result property="appSecret"           column="app_secret"             />
        <result property="privateKey"          column="private_key"            />
        <result property="secret"              column="secret"                 />
        <result property="status"              column="status"                 />
        <result property="createTime"          column="create_time"            />
        <result property="updateTime"          column="update_time"            />
        <result property="summary"             column="summary"                />
        <result property="orderCountLimit"     column="order_count_limit"      />
        <result property="userDailyCountLimit" column="user_daily_count_limit" />
        <result property="userDailySumLimit"   column="user_daily_sum_limit"   />
        <result property="orderSumLimit"       column="order_sum_limit"        />
        <result property="depositBalance"      column="deposit_balance"        />
        <result property="dailyStartTime"      column="daily_start_time"       />
        <result property="dailyEndTime"        column="daily_end_time"         />
        <result property="telegramChatIds"     column="telegram_chat_ids"      />
    </resultMap>

    <select id="selectByCode" parameterType="String" resultMap="ImspayMerchantResult">
        select * from imspay_merchant where code = #{code} limit 1
    </select>

    <select id="selectById" parameterType="String" resultMap="ImspayMerchantResult">
        select * from imspay_merchant where id = #{id} limit 1
    </select>

    <select id="selectMerchantList" parameterType="com.ruoyi.mall.domain.ImspayMerchant" resultMap="ImspayMerchantResult">
        select * from imspay_merchant
        <where>
            <if test="code != null and code != ''">AND code like concat('%', #{code}, '%')</if>
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertMerchant" parameterType="com.ruoyi.mall.domain.ImspayMerchant">
        insert into imspay_merchant(id, code, name, app_secret, status, summary,
            order_count_limit, user_daily_count_limit, user_daily_sum_limit, order_sum_limit,
            telegram_chat_ids, create_time, update_time)
        values(#{id}, #{code}, #{name}, #{appSecret}, #{status}, #{summary},
            #{orderCountLimit}, #{userDailyCountLimit}, #{userDailySumLimit}, #{orderSumLimit},
            #{telegramChatIds}, now(), now())
    </insert>

    <update id="updateMerchant" parameterType="com.ruoyi.mall.domain.ImspayMerchant">
        update imspay_merchant
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="appSecret != null and appSecret != ''">app_secret = #{appSecret},</if>
            <if test="status != null">status = #{status},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="orderCountLimit != null">order_count_limit = #{orderCountLimit},</if>
            <if test="userDailyCountLimit != null">user_daily_count_limit = #{userDailyCountLimit},</if>
            <if test="userDailySumLimit != null">user_daily_sum_limit = #{userDailySumLimit},</if>
            <if test="orderSumLimit != null">order_sum_limit = #{orderSumLimit},</if>
            <if test="telegramChatIds != null">telegram_chat_ids = #{telegramChatIds},</if>
            update_time = now()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="String">
        delete from imspay_merchant where id = #{id}
    </delete>

</mapper>
