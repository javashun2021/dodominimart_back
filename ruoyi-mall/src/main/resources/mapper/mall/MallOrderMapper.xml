<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallOrderMapper">

    <resultMap type="com.ruoyi.mall.domain.MallOrder" id="MallOrderResult">
        <id     property="orderId"          column="order_id"          />
        <result property="orderNo"          column="order_no"          />
        <result property="memberId"         column="member_id"         />
        <result property="addressSnapshot"  column="address_snapshot"  />
        <result property="totalAmount"      column="total_amount"      />
        <result property="status"           column="status"            />
        <result property="remark"           column="remark"            />
        <result property="paymentMethod"    column="payment_method"    />
        <result property="paymentStatus"    column="payment_status"    />
        <result property="paymentNo"        column="payment_no"        />
        <result property="paidAmount"       column="paid_amount"       />
        <result property="paymentTime"      column="payment_time"      />
        <result property="cancelReason"     column="cancel_reason"     />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
    </resultMap>

    <sql id="selectOrderVo">
        select order_id, order_no, member_id, address_snapshot, total_amount, status,
               remark, payment_method, payment_status, payment_no, paid_amount, payment_time,
               cancel_reason, create_time, update_by, update_time
        from mall_order
    </sql>

    <select id="selectOrderList" parameterType="com.ruoyi.mall.domain.MallOrder" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="memberId != null">AND member_id = #{memberId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="orderNo != null and orderNo != ''">AND order_no like concat('%', #{orderNo}, '%')</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectOrderById" parameterType="Long" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/> where order_id = #{orderId}
    </select>

    <select id="selectOrderByOrderNo" parameterType="String" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/> where order_no = #{orderNo}
    </select>

    <insert id="insertOrder" parameterType="com.ruoyi.mall.domain.MallOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into mall_order(order_no, member_id, address_snapshot, total_amount, status, remark,
                               payment_method, payment_status, create_time)
        values(#{orderNo}, #{memberId}, #{addressSnapshot}, #{totalAmount}, #{status}, #{remark},
               #{paymentMethod}, 'UNPAID', #{createTime})
    </insert>

    <update id="updateOrder" parameterType="com.ruoyi.mall.domain.MallOrder">
        update mall_order
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="paymentStatus != null">payment_status = #{paymentStatus},</if>
            <if test="paymentNo != null">payment_no = #{paymentNo},</if>
            <if test="paidAmount != null">paid_amount = #{paidAmount},</if>
            <if test="paymentTime != null">payment_time = #{paymentTime},</if>
            <if test="cancelReason != null">cancel_reason = #{cancelReason},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = #{updateTime}
        </set>
        where order_id = #{orderId}
    </update>

</mapper>
