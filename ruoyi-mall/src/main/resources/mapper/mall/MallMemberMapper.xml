<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallMemberMapper">

    <resultMap type="com.ruoyi.mall.domain.MallMember" id="MallMemberResult">
        <id     property="memberId"     column="member_id"    />
        <result property="googleId"     column="google_id"    />
        <result property="appleId"      column="apple_id"     />
        <result property="email"        column="email"        />
        <result property="nickName"     column="nick_name"    />
        <result property="avatarUrl"    column="avatar_url"   />
        <result property="phone"        column="phone"        />
        <result property="status"        column="status"         />
        <result property="passwordHash"  column="password_hash"  />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="fcmToken"      column="fcm_token"      />
        <result property="points"        column="points"         />
        <result property="inviteCode"    column="invite_code"    />
        <result property="referrerId"    column="referrer_id"    />
    </resultMap>

    <sql id="selectMemberVo">
        select member_id, google_id, apple_id, email, nick_name, avatar_url, phone, status, password_hash, create_time, update_time, fcm_token, points, invite_code, referrer_id
        from mall_member
    </sql>

    <select id="selectMemberList" parameterType="com.ruoyi.mall.domain.MallMember" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/>
        <where>
            <if test="email != null and email != ''">AND email like concat('%', #{email}, '%')</if>
            <if test="nickName != null and nickName != ''">AND nick_name like concat('%', #{nickName}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMemberById" parameterType="Long" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/> where member_id = #{memberId}
    </select>

    <select id="selectMemberByGoogleId" parameterType="String" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/> where google_id = #{googleId}
    </select>

    <select id="selectMemberByAppleId" parameterType="String" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/> where apple_id = #{appleId}
    </select>

    <select id="selectMemberByEmail" parameterType="String" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/> where email = #{email}
    </select>

    <select id="selectMembersByIds" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/>
        where member_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insertMember" parameterType="com.ruoyi.mall.domain.MallMember" useGeneratedKeys="true" keyProperty="memberId">
        insert into mall_member(google_id, apple_id, email, nick_name, avatar_url, phone, status, password_hash, create_time)
        values(#{googleId}, #{appleId}, #{email}, #{nickName}, #{avatarUrl}, #{phone}, #{status}, #{passwordHash}, #{createTime})
    </insert>

    <update id="updateMember" parameterType="com.ruoyi.mall.domain.MallMember">
        update mall_member
        <set>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime}
        </set>
        where member_id = #{memberId}
    </update>

    <update id="updateFcmToken">
        update mall_member set fcm_token = #{fcmToken}, update_time = now()
        where member_id = #{memberId}
    </update>

    <select id="selectByInviteCode" parameterType="String" resultMap="MallMemberResult">
        <include refid="selectMemberVo"/> where invite_code = #{inviteCode}
    </select>

    <update id="updateInviteCode">
        update mall_member set invite_code = #{inviteCode}, update_time = now()
        where member_id = #{memberId}
    </update>

    <update id="updateReferrerId">
        update mall_member set referrer_id = #{referrerId}, update_time = now()
        where member_id = #{memberId}
    </update>

    <resultMap type="com.ruoyi.mall.domain.MallMember" id="ReferralMemberResult" extends="MallMemberResult">
        <result property="completedOrderCount" column="completed_order_count"/>
    </resultMap>

    <select id="selectReferredMembers" parameterType="Long" resultMap="ReferralMemberResult">
        select m.member_id, m.nick_name, m.avatar_url, m.create_time,
               count(o.order_id) as completed_order_count
        from mall_member m
        left join mall_order o
            on o.member_id = m.member_id and o.status = '3'
        where m.referrer_id = #{referrerId}
        group by m.member_id, m.nick_name, m.avatar_url, m.create_time
        order by m.create_time desc
    </select>

</mapper>
