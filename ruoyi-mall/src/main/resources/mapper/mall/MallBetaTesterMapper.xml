<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.mall.mapper.MallBetaTesterMapper">

    <resultMap id="BetaTesterResult" type="com.ruoyi.mall.domain.MallBetaTester">
        <id     property="id"          column="id"/>
        <result property="email"       column="email"/>
        <result property="status"      column="status"/>
        <result property="source"      column="source"/>
        <result property="memberId"    column="member_id"/>
        <result property="ip"          column="ip"/>
        <result property="createTime"  column="create_time"/>
        <result property="approveTime" column="approve_time"/>
        <result property="remark"      column="remark"/>
    </resultMap>

    <sql id="cols">id, email, status, source, member_id, ip, create_time, approve_time, remark</sql>

    <select id="selectByEmail" parameterType="String" resultMap="BetaTesterResult">
        SELECT <include refid="cols"/>
        FROM mall_beta_tester
        WHERE email = #{email}
        LIMIT 1
    </select>

    <insert id="insertTester" parameterType="com.ruoyi.mall.domain.MallBetaTester" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mall_beta_tester
            (email, status, source, member_id, ip, create_time, remark)
        VALUES
            (#{email}, #{status}, #{source}, #{memberId}, #{ip}, #{createTime}, #{remark})
    </insert>

    <update id="approveByEmail" parameterType="com.ruoyi.mall.domain.MallBetaTester">
        UPDATE mall_beta_tester
        SET status = 'approved',
            approve_time = #{approveTime}
        WHERE email = #{email}
    </update>

</mapper>
