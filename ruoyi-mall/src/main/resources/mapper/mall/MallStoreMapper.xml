<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallStoreMapper">

    <resultMap type="com.ruoyi.mall.domain.MallStore" id="MallStoreResult">
        <id     property="storeId"          column="store_id"          />
        <result property="merchantId"       column="merchant_id"       />
        <result property="merchantName"     column="merchant_name"     />
        <result property="name"             column="name"              />
        <result property="address"          column="address"           />
        <result property="lat"              column="lat"               />
        <result property="lng"              column="lng"               />
        <result property="phone"            column="phone"             />
        <result property="serviceRadiusKm"  column="service_radius_km" />
        <result property="businessHours"    column="business_hours"    />
        <result property="status"           column="status"            />
        <result property="sort"             column="sort"              />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectStoreVo">
        select store_id, merchant_id,
               (select name from mall_merchant mm where mm.merchant_id = mall_store.merchant_id) as merchant_name,
               name, address, lat, lng, phone, service_radius_km, business_hours,
               status, sort, del_flag, create_by, create_time, update_by, update_time, remark
        from mall_store
    </sql>

    <select id="selectStoreList" parameterType="com.ruoyi.mall.domain.MallStore" resultMap="MallStoreResult">
        <include refid="selectStoreVo"/>
        <where>
            del_flag = '0'
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="merchantId != null">AND merchant_id = #{merchantId}</if>
        </where>
        order by sort asc, store_id asc
    </select>

    <select id="selectStoreById" parameterType="Long" resultMap="MallStoreResult">
        <include refid="selectStoreVo"/>
        where store_id = #{storeId}
    </select>

    <select id="selectActiveStores" resultMap="MallStoreResult">
        <include refid="selectStoreVo"/>
        where del_flag = '0' and status = '0'
        order by sort asc, store_id asc
    </select>

    <insert id="insertStore" parameterType="com.ruoyi.mall.domain.MallStore" useGeneratedKeys="true" keyProperty="storeId">
        insert into mall_store(merchant_id, name, address, lat, lng, phone, service_radius_km, business_hours,
                               status, sort, del_flag, create_by, create_time)
        values(#{merchantId}, #{name}, #{address}, #{lat}, #{lng}, #{phone},
               ifnull(#{serviceRadiusKm}, 5), #{businessHours},
               ifnull(#{status}, '0'), ifnull(#{sort}, 0), '0', #{createBy}, #{createTime})
    </insert>

    <update id="updateStore" parameterType="com.ruoyi.mall.domain.MallStore">
        update mall_store
        <set>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="address != null">address = #{address},</if>
            <if test="lat != null">lat = #{lat},</if>
            <if test="lng != null">lng = #{lng},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="serviceRadiusKm != null">service_radius_km = #{serviceRadiusKm},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = #{updateTime}
        </set>
        where store_id = #{storeId}
    </update>

    <update id="deleteStoreById" parameterType="Long">
        update mall_store set del_flag = '2' where store_id = #{storeId}
    </update>

</mapper>
